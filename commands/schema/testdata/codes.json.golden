{
  "codes": [
    {
      "code": "GENERIC_ERROR",
      "exitCode": 1,
      "retryable": false,
      "meaning": "Unclassified failure (no typed exit code); consult the message"
    },
    {
      "code": "USAGE_ERROR",
      "exitCode": 2,
      "retryable": false,
      "meaning": "CLI misuse: unknown flag, bad value, wrong number of positional args"
    },
    {
      "code": "SAFETY_FLAG_REQUIRED",
      "exitCode": 3,
      "retryable": false,
      "meaning": "A named safety flag is missing; re-run with the flag in `requires`"
    },
    {
      "code": "POLICY_READONLY",
      "exitCode": 4,
      "retryable": false,
      "meaning": "Refused by the read-only environment policy; not resolvable by a flag"
    },
    {
      "code": "AUTH_FAILED",
      "exitCode": 10,
      "retryable": false,
      "meaning": "Authentication failed: no Account, invalid credential, token refused"
    },
    {
      "code": "PERMISSION_DENIED",
      "exitCode": 11,
      "retryable": false,
      "meaning": "Authorization failed (403): the Account is not invited on this app"
    },
    {
      "code": "VALIDATION_FAILED",
      "exitCode": 20,
      "retryable": false,
      "meaning": "Client-side validation rejected the input before the API accepted it"
    },
    {
      "code": "INVALID_ARGUMENT",
      "exitCode": 30,
      "retryable": false,
      "meaning": "The API rejected the request as malformed (400)"
    },
    {
      "code": "NOT_FOUND",
      "exitCode": 30,
      "retryable": false,
      "meaning": "The API found no such package, track, Edit or resource (404)"
    },
    {
      "code": "BASE_PLAN_NOT_DRAFT",
      "exitCode": 30,
      "retryable": false,
      "meaning": "The API only deletes a DRAFT base plan; deactivate it first (state: INACTIVE), apply, then remove it"
    },
    {
      "code": "API_ERROR",
      "exitCode": 30,
      "retryable": false,
      "meaning": "Other API 4xx rejection"
    },
    {
      "code": "UPSTREAM_UNAVAILABLE",
      "exitCode": 40,
      "retryable": true,
      "meaning": "The API is temporarily unhealthy (5xx); retry"
    },
    {
      "code": "NETWORK_ERROR",
      "exitCode": 50,
      "retryable": true,
      "meaning": "Network failure with no HTTP response: timeout, DNS, refused"
    },
    {
      "code": "STATE_CONFLICT",
      "exitCode": 60,
      "retryable": false,
      "meaning": "Remote state conflicts with the request (409)"
    },
    {
      "code": "EDIT_ALREADY_EXISTS",
      "exitCode": 60,
      "retryable": false,
      "meaning": "An Edit is already open on this package; commit or delete it first"
    },
    {
      "code": "EDIT_EXPIRED",
      "exitCode": 60,
      "retryable": false,
      "meaning": "The pinned Edit expired; clear its pin with `gplay edits discard`, then begin a new Edit and replay the mutation"
    },
    {
      "code": "RATE_LIMIT_EXCEEDED",
      "exitCode": 60,
      "retryable": true,
      "meaning": "Rate or quota limit exceeded; back off and retry"
    },
    {
      "code": "FINDINGS_PRESENT",
      "exitCode": 70,
      "retryable": false,
      "meaning": "A read-only check command completed and reported findings; not a failure"
    }
  ]
}
