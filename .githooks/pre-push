#!/bin/sh
# pre-push: runs `make check`, the local mirror of the required CI checks, so a
# red gate is caught before the push instead of minutes later in CI.
#
# Opt-in: `make install-hooks`. Skip once with `git push --no-verify`.
# It checks the working tree, not the pushed commits: push from a clean tree.

# A push made only of branch deletions ships no code: nothing to check.
zero=0000000000000000000000000000000000000000
code=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
	[ "$local_sha" = "$zero" ] || code=1
done
[ "$code" = 1 ] || exit 0

cd "$(git rev-parse --show-toplevel)" || exit 1
exec make check
