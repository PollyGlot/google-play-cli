    <!-- Landing theme control. Self-contained 3-state selector bound to the
         same `starlight-theme` key the docs use (empty string = System, the
         Starlight storage contract), so one choice carries across the site.
         Applies instantly, persists, and follows the OS while in System. -->
    <script is:inline>
      (() => {
        const KEY = 'starlight-theme';
        const radios = Array.from(
          document.querySelectorAll('#theme-toggle input[name="theme"]')
        );
        if (!radios.length) return;
        const parse = (t) => (t === 'auto' || t === 'light' || t === 'dark' ? t : 'auto');
        const load = () => {
          try {
            return parse(localStorage.getItem(KEY));
          } catch {
            return 'auto';
          }
        };
        const osTheme = () =>
          window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        const store = (t) => {
          try {
            localStorage.setItem(KEY, t === 'light' || t === 'dark' ? t : '');
          } catch {}
        };
        const apply = (pref) => {
          const t = pref === 'auto' ? osTheme() : pref;
          document.documentElement.dataset.theme = t;
          // Keep the mobile chrome in sync with the resolved theme.
          const tc = document.querySelector('meta[name="theme-color"]:not([media])');
          if (tc) tc.setAttribute('content', t === 'light' ? '#ffffff' : '#050507');
        };
        const reflect = (pref) => {
          radios.forEach((r) => {
            const on = r.value === pref;
            r.checked = on;
            r.closest('.theme-opt').classList.toggle('is-active', on);
          });
        };
        reflect(load());
        radios.forEach((r) =>
          r.addEventListener('change', () => {
            if (!r.checked) return;
            const v = parse(r.value);
            apply(v);
            store(v);
            reflect(v);
          })
        );
        window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
          if (load() === 'auto') apply('auto');
        });
      })();
    </script>

    <!-- Hero terminal typing animation. Progressive enhancement over the
         server-rendered session (single source: demoSession): replays the same
         commands with a typed effect, once, then leaves a blinking cursor.
         No JS or prefers-reduced-motion → the static session stays as-is.
         The <pre> height is locked before clearing so nothing shifts (CLS 0),
         and the container's role="img" aria-label keeps the announced content
         stable throughout. -->
    <script is:inline define:vars={{ session: demoSession }}>
      (() => {
        const pre = document.getElementById('demo-pre');
        const code = document.getElementById('demo-code');
        if (!pre || !code) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        const finalHTML = code.innerHTML;
        const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
        const span = (className) => {
          const el = document.createElement('span');
          el.className = className;
          return el;
        };

        const run = async () => {
          pre.style.minHeight = `${pre.offsetHeight}px`;
          code.textContent = '';
          const cursor = span('demo-cursor');
          code.appendChild(cursor);
          // Insert everything before the cursor so it always trails the output.
          const put = (node) => code.insertBefore(node, cursor);

          const type = async (target, text) => {
            for (const char of text) {
              target.textContent += char;
              await sleep(14 + Math.random() * 24);
            }
          };

          await sleep(500);
          for (const [index, entry] of session.entries()) {
            if (index > 0) {
              put(document.createTextNode('\n'));
              await sleep(700);
            }
            const prompt = span('text-brand');
            prompt.textContent = '$';
            put(prompt);
            put(document.createTextNode(' '));
            const cmd = span('text-zinc-100');
            put(cmd);
            await type(cmd, entry.cmd);
            await sleep(350);
            put(document.createTextNode('\n'));
            if (entry.out) {
              const out = span('text-zinc-400');
              out.textContent = entry.out;
              put(out);
              put(document.createTextNode('\n'));
            }
          }
        };

        run().catch(() => {
          // Any surprise mid-animation: fall back to the full static session.
          code.innerHTML = finalHTML;
        });
      })();
    </script>
  </body>
</html>
