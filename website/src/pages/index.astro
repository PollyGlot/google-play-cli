---
import '../styles/global.css';
import '../styles/theme.css';
import InstallTabs from '../components/InstallTabs.tsx';
import logoMark from '../assets/logo-mark.svg';
import surface from '../data/cli-surface.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = (Astro.site ?? new URL('https://gplay.sh')).origin;
const canonical = `${site}${base}/`;

const GITHUB = 'https://github.com/PollyGlot/google-play-cli';
const SKILLS_REPO = 'https://github.com/PollyGlot/google-play-cli-skills';

const title = 'gplay — Google Play Developer CLI for CI and AI agents';
const description =
  'gplay is a fast, single-binary CLI for the Google Play Developer API. Upload releases, run staged rollouts, sync store listings, reply to reviews, and manage your Play Console team — from your terminal, CI pipeline, or AI agent. Open source, MIT.';

// Command namespaces, taken from the generated CLI surface (gplay --help).
const namespaces = surface.namespaces.filter((n) => n.name !== 'init');

const stats = [
  { value: String(surface.commands), label: 'commands' },
  { value: String(namespaces.length), label: 'namespaces' },
  { value: '1', label: 'static binary' },
  { value: '0', label: 'runtime deps' },
];

const features = [
  {
    title: 'One static binary',
    body: 'Written in Go. No Ruby, no Node, no Python in your CI image — one file, fast cold start, trivial caching.',
  },
  {
    title: 'CI-first output',
    body: 'TTY-aware: tables for humans, raw Google Play API JSON in pipes and CI. stdout carries data only; logs go to stderr.',
  },
  {
    title: 'Semantic exit codes',
    body: 'Exit 40/50 mean "retry me", exit 3 names the missing safety flag, the rest fail fast. Retry logic without parsing error text.',
  },
  {
    title: 'Safe production defaults',
    body: 'Uploads and promotions to production land as drafts. Reaching real users always takes an explicit --complete or --staged, plus --confirm.',
  },
  {
    title: 'Store front as code',
    body: 'Pull listings and images into a fastlane-compatible tree, validate offline, diff with --dry-run, apply additively. Deletion is opt-in.',
  },
  {
    title: 'Agent-first design',
    body: 'Dry-runs announce the safety flags a write needs, the API schema is introspectable offline, and the docs ship as llms.txt.',
  },
];

const faq = [
  {
    q: 'What is gplay?',
    a: 'gplay is an open-source command-line interface for the Google Play Developer API, shipped as a single static Go binary. It uploads and promotes releases, runs staged rollouts, manages tracks and testers, syncs store listings and images, replies to reviews, pushes Data Safety declarations, and administers Play Console users and permissions.',
  },
  {
    q: 'How is gplay different from Fastlane supply?',
    a: 'No Ruby runtime — gplay is one static binary, so CI images stay small and cold starts stay fast. Output is machine-stable (raw API JSON in pipes), exit codes are semantic so scripts know what is retryable, and production uploads default to draft releases instead of publishing to 100% of users. An existing fastlane metadata tree drops in unchanged.',
  },
  {
    q: 'Does gplay work in CI?',
    a: 'Yes — that is its home turf. Credentials inject via the GPLAY_SERVICE_ACCOUNT environment variable (file path or inline JSON), CI=true switches output to JSON automatically, no command ever prompts interactively, and exit codes 40/50 mark exactly the failures worth retrying.',
  },
  {
    q: 'Can AI agents drive gplay?',
    a: 'Yes, by design. JSON output mirrors the Google Play API schemas, refusals are machine-resolvable (exit 3 names the missing acknowledgment flag), --dry-run previews any write without HTTP, gplay schema answers API-shape questions offline, and this site publishes llms.txt and llms-full.txt. A companion repo ships ready-made agent skills: npx skills add PollyGlot/google-play-cli-skills.',
  },
  {
    q: 'Is gplay free?',
    a: 'Yes — open source under the MIT license. The source, issue tracker, and architecture decision records are public on GitHub.',
  },
  {
    q: 'Is gplay affiliated with Google?',
    a: 'No. gplay is an independent open-source project that uses the public Google Play Developer API. It is not endorsed by, affiliated with, or sponsored by Google LLC. "Google Play" is a trademark of Google LLC.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'gplay',
    alternateName: 'google-play-cli',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Linux, macOS, Windows',
    description,
    url: canonical,
    downloadUrl: `${GITHUB}/releases`,
    softwareHelp: `${canonical}docs/`,
    license: 'https://opensource.org/license/mit',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    sameAs: [GITHUB, SKILLS_REPO],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'gplay',
    url: canonical,
  },
];

// Real `releases upload` table output shape (commands/releases/upload/upload.go
// renderTable) with format-faithful demo values — not a captured real app.
const demoUploadOutput = `versionCode:  421
track:        internal
status:       completed
userFraction: 1
releaseName:  421
locales:      [en-US fr-FR]`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- First-paint theme resolution: read the shared Starlight preference,
         else the OS, and set data-theme before paint so there is no flash.
         Same storage key the docs use, so a choice carries across the site. -->
    <script is:inline>
      (() => {
        const stored = (() => {
          try {
            return localStorage.getItem('starlight-theme');
          } catch {
            return null;
          }
        })();
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <meta name="theme-color" content="#050507" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}${base}/og-default.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}${base}/og-default.png`} />
    {jsonLd.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body class="m-0 bg-surface font-sans text-fg-body antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-brand focus:px-3 focus:py-2 focus:text-ink"
      >Skip to content</a
    >

    <header class="border-b border-border">
      <nav
        class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-6 gap-y-2 px-5 py-4"
        aria-label="Main"
      >
        <a href={`${base}/`} class="flex items-center gap-2 no-underline">
          <img src={logoMark.src} alt="" width="28" height="21" />
          <span class="font-mono text-lg font-bold text-fg">gplay</span>
        </a>
        <span
          class="rounded-full border border-border-strong px-2 py-0.5 text-xs text-fg-muted"
          title="Pre-1.0: surface may still change before GA"
        >
          public preview
        </span>
        <div class="ml-auto flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
          <a href={`${base}/docs/`} class="text-fg-body no-underline hover:text-accent">Docs</a>
          <a href={`${base}/docs/reference/`} class="text-fg-body no-underline hover:text-accent"
            >CLI reference</a
          >
          <a
            href={`${base}/docs/agents/agent-guide/`}
            class="text-fg-body no-underline hover:text-accent">AI agents</a
          >
          <a href="#faq" class="text-fg-body no-underline hover:text-accent">FAQ</a>
          <a href={GITHUB} class="text-fg-body no-underline hover:text-accent">GitHub</a>
          <label class="flex items-center">
            <span class="sr-only">Theme</span>
            <select
              id="theme-select"
              aria-label="Theme"
              class="cursor-pointer rounded-md border border-border bg-surface px-2 py-1 font-sans text-sm text-fg-body transition-colors hover:border-accent"
            >
              <option value="auto">System</option>
              <option value="light">Light</option>
              <option value="dark">Dark</option>
            </select>
          </label>
        </div>
      </nav>
    </header>

    <main id="main">
      <!-- Hero -->
      <section class="relative overflow-hidden" aria-label="Introduction">
        <div
          class="pointer-events-none absolute inset-0"
          style="background:
            radial-gradient(42rem 22rem at 85% -10%, rgba(130,175,255,0.10), transparent),
            radial-gradient(36rem 20rem at 10% 110%, rgba(61,220,132,0.08), transparent);"
        >
        </div>
        <div class="relative mx-auto grid max-w-5xl gap-12 px-5 py-16 md:grid-cols-2 md:py-24">
          <div>
            <h1 class="m-0 text-4xl font-bold leading-tight text-fg md:text-5xl">
              Ship to Google Play from your <span class="text-accent">terminal</span>
            </h1>
            <p class="mt-5 max-w-prose text-lg leading-relaxed text-fg-muted">
              gplay is a fast, single-binary CLI for the Google Play Developer API. Releases,
              staged rollouts, store listings, reviews, compliance, and team management — built
              for CI pipelines and AI agents, designed to replace Fastlane on Android pipelines.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a
                href={`${base}/docs/getting-started/installation/`}
                class="rounded-md bg-brand px-5 py-2.5 font-semibold text-ink no-underline transition-colors hover:bg-brand-dim"
                >Get started</a
              >
              <a
                href={`${base}/docs/`}
                class="rounded-md border border-border-strong px-5 py-2.5 font-semibold text-fg-body no-underline transition-colors hover:border-accent hover:text-accent"
                >Read the docs</a
              >
            </div>
            <p class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm">
              <!-- Dark island: a copy-pasteable command reads as terminal output,
                   so it keeps its dark surface and neon prompt in every theme. -->
              <span
                class="inline-flex items-center gap-2 rounded-md border border-zinc-800 bg-zinc-950 px-3 py-1.5 font-mono text-zinc-100"
              >
                <span class="select-none text-brand">$</span> brew install PollyGlot/tap/gplay
              </span>
              <a
                href="#install"
                class="font-mono text-fg-muted underline underline-offset-4 hover:text-accent"
                >more options ↓</a
              >
            </p>
          </div>

          <!-- Terminal demo: command output matches the real renderTable shape;
               values are format-faithful demo data. -->
          <div
            class="self-center overflow-hidden rounded-lg border border-zinc-800 bg-zinc-950 shadow-2xl"
            role="img"
            aria-label="Terminal session showing a gplay release upload, promotion, and staged rollout"
          >
            <div class="flex items-center gap-1.5 border-b border-zinc-800 bg-zinc-900 px-4 py-2.5">
              <span class="h-2.5 w-2.5 rounded-full bg-zinc-700"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-zinc-700"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-zinc-700"></span>
              <span class="ml-2 font-mono text-xs text-zinc-500">release day</span>
            </div>
            <pre
              class="m-0 overflow-x-auto p-4 font-mono text-[13px] leading-relaxed"><code><span class="text-brand">$</span> <span class="text-zinc-100">gplay releases upload app.aab --track internal \</span>
<span class="text-zinc-100">    --release-notes-dir ./whatsnew</span>
<span class="text-zinc-500">{demoUploadOutput}</span>

<span class="text-brand">$</span> <span class="text-zinc-100">gplay releases promote --from internal --to beta</span>

<span class="text-brand">$</span> <span class="text-zinc-100">gplay releases rollout --track production \</span>
<span class="text-zinc-100">    --to 0.10 --confirm</span></code></pre>
          </div>
        </div>

        <!-- Stats -->
        <div class="border-y border-border bg-surface-panel">
          <dl class="mx-auto grid max-w-5xl grid-cols-2 gap-6 px-5 py-8 text-center md:grid-cols-4">
            {stats.map((s) => (
              <div>
                <dt class="order-2 text-sm text-fg-muted">{s.label}</dt>
                <dd class="m-0 font-mono text-3xl font-bold text-accent">{s.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <!-- Features -->
      <section id="features" class="mx-auto max-w-5xl px-5 py-16" aria-label="Features">
        <h2 class="m-0 text-3xl font-bold text-fg">Built for pipelines, not demos</h2>
        <p class="mt-3 max-w-prose text-fg-muted">
          Every design decision is documented in public
          <a href={`${GITHUB}/tree/main/docs/adr`} class="text-accent underline underline-offset-4"
            >architecture decision records</a
          >. These are the load-bearing ones.
        </p>
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {features.map((f) => (
            <article class="rounded-lg border border-border bg-surface-panel p-5">
              <h3 class="m-0 text-base font-semibold text-fg">{f.title}</h3>
              <p class="mb-0 mt-2 text-sm leading-relaxed text-fg-muted">{f.body}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- Command surface -->
      <section
        id="commands"
        class="border-y border-border bg-surface-panel"
        aria-label="Command surface"
      >
        <div class="mx-auto max-w-5xl px-5 py-16">
          <h2 class="m-0 text-3xl font-bold text-fg">The command surface</h2>
          <p class="mt-3 max-w-prose text-fg-muted">
            {surface.commands} commands across {namespaces.length} namespaces — every page of the
            <a href={`${base}/docs/reference/`} class="text-accent underline underline-offset-4"
              >CLI reference</a
            > is generated from the binary's own <code class="font-mono text-fg-body">--help</code>,
            so docs never drift from the tool.
          </p>
          <div class="mt-10 grid gap-3 sm:grid-cols-2">
            {namespaces.map((n) => (
              <a
                href={`${base}/docs/reference/${n.name}/`}
                class="group flex items-baseline gap-3 rounded-md border border-border px-4 py-3 no-underline transition-colors hover:border-accent"
              >
                <code class="shrink-0 font-mono text-sm font-semibold text-accent">
                  gplay {n.name}
                </code>
                <span class="text-sm text-fg-muted group-hover:text-fg-body">{n.short}</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- AI agents -->
      <section id="agents" class="mx-auto max-w-5xl px-5 py-16" aria-label="AI agents">
        <h2 class="m-0 text-3xl font-bold text-fg">A CLI your AI agent already understands</h2>
        <div class="mt-8 grid gap-10 md:grid-cols-2">
          <div class="text-fg-muted">
            <p class="mt-0 leading-relaxed">
              gplay treats autonomous callers as first-class users. JSON output mirrors the Google
              Play API schemas verbatim. A refused write names the exact safety flag it needs
              (exit code 3) instead of dead-ending. <code class="font-mono text-fg-body">--dry-run</code>
              previews any mutation without HTTP — and on team writes it returns a
              <code class="font-mono text-fg-body">requires</code> array announcing the gates ahead.
            </p>
            <p class="leading-relaxed">
              The docs you're reading ship as
              <a href={`${base}/llms.txt`} class="text-accent underline underline-offset-4">llms.txt</a>
              and
              <a href={`${base}/llms-full.txt`} class="text-accent underline underline-offset-4"
                >llms-full.txt</a
              >, including the full generated command reference. The
              <a
                href={`${base}/docs/agents/agent-guide/`}
                class="text-accent underline underline-offset-4">agent guide</a
              > spells out the whole contract.
            </p>
          </div>
          <div>
            <p class="mt-0 text-sm font-semibold uppercase tracking-wide text-fg-muted">
              Ready-made skills
            </p>
            <!-- Dark island: shell snippet stays dark in every theme. -->
            <div class="rounded-lg border border-zinc-800 bg-zinc-950 p-4">
              <code class="block overflow-x-auto font-mono text-sm text-zinc-100">
                <span class="select-none text-brand">$ </span>npx skills add PollyGlot/google-play-cli-skills
              </code>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-fg-muted">
              Nine skills — one per namespace plus a conventions foundation — each documenting the
              safe command sequence for its workflow, for Claude Code and compatible tools.
              <a href={`${base}/docs/agents/skills/`} class="text-accent underline underline-offset-4"
                >Browse the roster</a
              >.
            </p>
          </div>
        </div>
      </section>

      <!-- Install -->
      <section
        id="install"
        class="border-y border-border bg-surface-panel"
        aria-label="Installation"
      >
        <div class="mx-auto max-w-3xl px-5 py-16">
          <h2 class="m-0 text-3xl font-bold text-fg">Install</h2>
          <p class="mt-3 text-fg-muted">
            One binary, four ways to get it. Then
            <a
              href={`${base}/docs/getting-started/quickstart/`}
              class="text-accent underline underline-offset-4">the quickstart</a
            > takes you from login to a release upload in five commands.
          </p>
          <div class="mt-8">
            <InstallTabs client:idle />
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section id="faq" class="mx-auto max-w-3xl px-5 py-16" aria-label="Frequently asked questions">
        <h2 class="m-0 text-3xl font-bold text-fg">FAQ</h2>
        <div class="mt-8 flex flex-col gap-3">
          {faq.map((f) => (
            <details class="group rounded-lg border border-border bg-surface-panel p-5 open:border-border-strong">
              <summary class="cursor-pointer list-none font-semibold text-fg marker:content-none group-open:text-accent">
                {f.q}
              </summary>
              <p class="mb-0 mt-3 leading-relaxed text-fg-muted">{f.a}</p>
            </details>
          ))}
        </div>
      </section>
    </main>

    <footer class="border-t border-border">
      <div class="mx-auto max-w-5xl px-5 py-10">
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
          <a href={`${base}/docs/`} class="text-fg-muted no-underline hover:text-accent">Docs</a>
          <a href={`${base}/docs/reference/`} class="text-fg-muted no-underline hover:text-accent"
            >CLI reference</a
          >
          <a href={GITHUB} class="text-fg-muted no-underline hover:text-accent">GitHub</a>
          <a href={`${GITHUB}/releases`} class="text-fg-muted no-underline hover:text-accent"
            >Releases</a
          >
          <a href={SKILLS_REPO} class="text-fg-muted no-underline hover:text-accent">Agent skills</a>
          <a href={`${base}/llms.txt`} class="text-fg-muted no-underline hover:text-accent"
            >llms.txt</a
          >
        </div>
        <p class="mt-6 max-w-prose text-xs leading-relaxed text-fg-subtle">
          gplay is an independent open-source project (MIT license), currently in public preview
          (pre-1.0). It uses the public Google Play Developer API and is not endorsed by,
          affiliated with, or sponsored by Google LLC. "Google Play" is a trademark of Google LLC.
        </p>
        <p class="mt-2 text-xs text-fg-subtle">© 2026 Pavlo Trinko and contributors.</p>
      </div>
    </footer>

    <!-- Landing theme control. Self-contained 3-state selector bound to the
         same `starlight-theme` key the docs use (empty string = System, the
         Starlight storage contract), so one choice carries across the site.
         Applies instantly, persists, and follows the OS while in System. -->
    <script is:inline>
      (() => {
        const KEY = 'starlight-theme';
        const select = document.getElementById('theme-select');
        if (!select) return;
        const parse = (t) => (t === 'auto' || t === 'light' || t === 'dark' ? t : 'auto');
        const load = () => {
          try {
            return parse(localStorage.getItem(KEY));
          } catch {
            return 'auto';
          }
        };
        const osTheme = () =>
          window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        const store = (t) => {
          try {
            localStorage.setItem(KEY, t === 'light' || t === 'dark' ? t : '');
          } catch {}
        };
        const apply = (pref) => {
          document.documentElement.dataset.theme = pref === 'auto' ? osTheme() : pref;
        };
        select.value = load();
        select.addEventListener('change', () => {
          const v = parse(select.value);
          apply(v);
          store(v);
        });
        window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
          if (load() === 'auto') apply('auto');
        });
      })();
    </script>
  </body>
</html>
