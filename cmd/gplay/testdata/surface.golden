# gplay command surface: every leaf, flag and exit code of the shipped binary.
# Generated from the cobra tree by "make contract-update"; never edit by hand.
# The first field is the stability. In a PR, a removed or modified line starting
# with "frozen" breaks the Public contract (ADR-0010, ADR-0042): CI requires a
# "!" in the PR title or an ADR reference in the PR body. Pure additions are
# compatible and pass (scripts/contract-gate.sh).

# Exit codes (docs/DESIGN.md section 9)
frozen exit 0 meaning="Success" retry-safe="n/a"
frozen exit 1 meaning="Generic error (fallback when nothing more specific fits)" retry-safe="no"
frozen exit 2 meaning="CLI misuse (unknown flag, bad value, wrong number of positional args)" retry-safe="no"
frozen exit 3 meaning="Safety flag required: well-formed, but a named --confirm/--grant-admin is missing; the message names it" retry-safe="re-run with the named flag"
frozen exit 4 meaning="Denied by environment policy (GPLAY_READONLY) (a mutating command was refused; NOT resolvable by adding a flag" retry-safe="no) change the environment"
frozen exit 10 meaning="Authentication failure (SA invalid, token refused, scope missing, no developer-id)" retry-safe="no"
frozen exit 11 meaning="Authorization (403: SA not invited on the app/account)" retry-safe="no"
frozen exit 20 meaning="Client-side validation (malformed AAB, unknown locale, ...)" retry-safe="no"
frozen exit 30 meaning="API 4xx other than auth/perms (not found, conflict, gone, ...)" retry-safe="no"
frozen exit 40 meaning="API 5xx (upstream temporarily unhealthy)" retry-safe="yes"
frozen exit 50 meaning="Network (timeout, DNS, refused)" retry-safe="yes"
frozen exit 60 meaning="State conflict (open edit, rate-limited, ambiguous target, ...)" retry-safe="sometimes"
frozen exit 70 meaning="Findings present (a read-only check command completed and reported drift; NOT an error)" retry-safe="no"

# Global flags (inherited by every leaf)
frozen global --account type=string default=""
frozen global --retry type=int default="0"
frozen global --service-account type=string default=""
frozen global --timeout type=duration default="0s"
frozen global --verbose -v type=bool default="false"

