# Build output
/bin/
/dist/
*.exe
*.test
*.out

# Wrangler local dev cache (Cloudflare Worker)
.wrangler/

# Go
vendor/
*.prof
coverage.txt
coverage.html

# Editor / OS / agents
# No trailing slash on .claude: worktrees symlink it to the repo root, and a
# `dir/` pattern never matches a symlink.
.DS_Store
.idea/
.vscode/
.claude
.cursor/
.aider*
*.swp
*.swo
*~

# gplay-local state (transient, per-developer)
.gplay/edit-*.json

# Secrets — never commit
*.json.bak
service_account*.json
service-account*.json
!service_account.example.json

# Goreleaser snapshots
goreleaser.snapshot/

# Skills CLI — fichiers réels partagés entre agents, ne pas versionner
.agents/
